# Copy this file to .env and fill in real values before running

PORT=3000

# Long random string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Set to "true" only when deployed behind a reverse proxy / load balancer
# (Render, Railway, Nginx, Cloudflare Tunnel, etc.) so the app reads the
# real visitor IP from the X-Forwarded-For header instead of the proxy's IP.
TRUST_PROXY=false

# For a public web release, set this to your real domain (e.g.
# https://chat.example.com) so only your own frontend can make authenticated
# requests to this API. Leave blank for LAN/dev use, where it reflects
# whatever origin the request came from.
ALLOWED_ORIGIN=

# Optional: enables the "Sign in with Google" button on the login screen.
# Leave blank to skip it entirely -- the app works fully without it.
# Get a Client ID from https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application). See README section 9 for the
# authorized-origins requirement and its limitation on LAN/IP access.
GOOGLE_CLIENT_ID=
